{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PREVIEW_MODE": "true"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "ios-device-preview": {
      "extends": "preview",
      "developmentClient": false,
      "node": "24.18.0",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "credentialsSource": "remote"
      }
    },
    "ios-simulator-preview": {
      "extends": "preview",
      "developmentClient": false,
      "node": "24.18.0",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    }
  }
}
