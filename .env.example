# Generate local secrets with npm run setup. Never commit the generated .env.
PORT=8080
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8080
OWNER_TOKEN=
DATA_KEY=
DATABASE_PATH=.data/safety.sqlite
# Defaults to test: nothing is sent, and the UI explicitly says so.
ALERT_MODE=test
# Required only for real SMS (ALERT_MODE=live).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp requires a registered sender and an approved eight-variable text template.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Optional self-hosted/contracted Nominatim-compatible reverse endpoint.
# Location is sent to this endpoint only when you configure it, in live mode.
GEOCODER_URL=
# Optional operator-maintained directory of consenting police partners.
POLICE_REGISTRY_PATH=
POLICE_WEBHOOK_TOKEN=
