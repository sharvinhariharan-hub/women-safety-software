{
  "name": "women-safety-software",
  "version": "0.2.0",
  "private": true,
  "description": "One-button SOS mobile application and private live-location service",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/index.mjs",
    "setup": "node server/src/setup.mjs",
    "test": "node --test server/test/*.test.mjs",
    "check:mobile": "npm --prefix mobile run typecheck"
  }
}
